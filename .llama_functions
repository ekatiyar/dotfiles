# Fixed Qwen 3.5/3.6/3.8 chat template (froggeric v22.4+)
_llama_sync_qwen_template() {
    local url="https://huggingface.co/froggeric/Qwen-Fixed-Chat-Templates/resolve/main/chat_template.jinja"
    local dest="${LLAMA_CACHE:-$HOME/repo/models}/templates/qwen-fixed-chat-template.jinja"

    mkdir -p "$(dirname "$dest")" || return 1
    # Stage in a temp file so a failed fetch can't truncate a working template.
    if curl -fsSL "$url" -o "$dest.tmp"; then
        mv "$dest.tmp" "$dest"
        echo "✅ Qwen chat template synced: $dest"
    else
        rm -f "$dest.tmp"
        echo "⚠️  Failed to fetch Qwen chat template; Qwen presets need $dest" >&2
        return 1
    fi
}

# Llama.cpp Build Pipeline
llmb() {
    cd ~/repo/llama.cpp || return
    echo "🔄 Pulling latest changes..."
    git pull

    echo "📄 Syncing Qwen chat template..."
    _llama_sync_qwen_template

    echo "⚙️ Configuring Llama.cpp..."
    cmake -B build -S . -DGGML_CUDA=ON -DBUILD_SHARED_LIBS=OFF -DGGML_CUDA_ALLREDUCE=ON -DGGML_CUDA_NCCL=OFF

    echo "🔨 Building binaries..."
    cmake --build build --config Release -j $(nproc) --clean-first --target llama-cli llama-server llama-bench llama-fit-params

    echo "✅ Build complete."
}

# Serve local coding models via llama-server router mode (see ~/.config/llama.cpp/preset.ini)
llama-router() {
    local LOGFILE="$HOME/llama-router.log"
    cd ~/repo/llama.cpp/build/bin || return

    local gpu_pid=""
    if command -v nvidia-smi >/dev/null 2>&1; then
        (
            while true; do
                nvidia-smi --query-gpu=timestamp,name,utilization.gpu,utilization.memory,memory.used,memory.total,temperature.gpu,power.draw \
                    --format=csv,noheader >> "$LOGFILE"
                sleep 60
            done
        ) &
        gpu_pid=$!
    fi

    # Safety net: if repeated Ctrl+C aborts this function early, still clean up the GPU loop.
    trap '[ -n "$gpu_pid" ] && kill "$gpu_pid" 2>/dev/null' INT TERM

    # Foreground pipeline: llama-server receives Ctrl+C/etc. directly, same as running it unwrapped.
    ./llama-server --models-preset ~/.config/llama.cpp/preset.ini --models-max 1 "$@" 2>&1 | tee -a "$LOGFILE"

    [ -n "$gpu_pid" ] && kill "$gpu_pid" 2>/dev/null
    trap - INT TERM
}
