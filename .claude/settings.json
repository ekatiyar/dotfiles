{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DISABLE_BUG_COMMAND": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_TELEMETRY": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(awk:*)",
      "Bash(cat:*)",
      "Bash(diff:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh label list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh release list:*)",
      "Bash(gh release view:*)",
      "Bash(gh repo view:*)",
      "Bash(gh search:*)",
      "Bash(git --no-pager diff:*)",
      "Bash(git --no-pager log:*)",
      "Bash(git diff:*)",
      "Bash(git grep:*)",
      "Bash(git log:*)",
      "Bash(git merge-base:*)",
      "Bash(git rev-list:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git status *)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(printf:*)",
      "Bash(readlink:*)",
      "Bash(rg:*)",
      "Bash(tail:*)",
      "Bash(type:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(zcat:*)",
      "WebSearch",
      "mcp__duckduckgo-search__fetch_content",
      "mcp__duckduckgo-search__search",
      "mcp__github__get_*",
      "mcp__github__issue_read",
      "mcp__github__list_*",
      "mcp__github__pull_request_read",
      "mcp__github__search_*",
      "mcp__ide__getDiagnostics",
      "mcp__reddit"
    ],
    "deny": [
      "Bash(gh issue close:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue reopen:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr reopen:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr update-branch:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo fork:*)",
      "Bash(sudo:*)",
      "mcp__github__add_comment_to_pending_review",
      "mcp__github__add_issue_comment",
      "mcp__github__assign_copilot_to_issue",
      "mcp__github__create_branch",
      "mcp__github__create_or_update_file",
      "mcp__github__create_pull_request",
      "mcp__github__create_repository",
      "mcp__github__delete_file",
      "mcp__github__fork_repository",
      "mcp__github__issue_write",
      "mcp__github__merge_pull_request",
      "mcp__github__pull_request_review_write",
      "mcp__github__push_files",
      "mcp__github__request_copilot_review",
      "mcp__github__sub_issue_write",
      "mcp__github__update_pull_request",
      "mcp__github__update_pull_request_branch"
    ],
    "ask": [
      "Bash(git*branch -D*)",
      "Bash(git*branch -d*)",
      "Bash(git*checkout -- *)",
      "Bash(git*clean*)",
      "Bash(git*commit*)",
      "Bash(git*merge*)",
      "Bash(git*push*)",
      "Bash(git*rebase*)",
      "Bash(git*reset*)",
      "Bash(git*restore*)",
      "Bash(git*stash*)",
      "Bash(git*tag*)",
      "Bash(git*worktree prune*)",
      "Bash(git*worktree remove*)",
      "Bash(gh api:*)",
      "Bash(kill:*)",
      "Bash(pkill:*)",
      "Bash(rm:*)"
    ],
    "defaultMode": "default"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/subagent-model-policy.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/sleep-wait-policy.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/plan-adherence.sh PostToolUse"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/plan-adherence.sh SessionStart"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/fable-orchestrator.sh"
          }
        ]
      }
    ]
  },
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh",
    "refreshInterval": 5
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "bash ~/.claude/subagent-statusline.sh"
  },
  "enabledPlugins": {},
  "alwaysThinkingEnabled": true,
  "outputStyle": "Plainspoken",
  "effortLevel": "high",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "showClearContextOnPlanAccept": true,
  "askUserQuestionTimeout": "never",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "theme": "auto",
  "preferredNotifChannel": "terminal_bell",
  "autoCompactEnabled": false,
  "switchModelsOnFlag": false,
  "teammateMode": "auto",
  "agentPushNotifEnabled": true
}
