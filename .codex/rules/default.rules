prefix_rule(
    pattern = ["sort"],
    decision = "allow",
)

prefix_rule(
    pattern = ["gh", ["--repo", "-R"]],
    decision = "prompt",
)

prefix_rule(
    pattern = ["gh", ["issue", "pr", "repo"], ["--repo", "-R"]],
    decision = "prompt",
)

prefix_rule(
    pattern = ["gh", "issue", ["close", "comment", "create", "delete", "edit", "reopen"]],
    decision = "forbidden",
)

prefix_rule(
    pattern = ["gh", "pr", ["close", "comment", "edit", "merge", "reopen", "review", "update-branch"]],
    decision = "forbidden",
)

prefix_rule(
    pattern = ["gh", "pr", "create"],
    decision = "prompt",
)

prefix_rule(
    pattern = ["gh", "repo", ["create", "fork"]],
    decision = "forbidden",
)

prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
)

prefix_rule(
    pattern = ["gh", ["issue", "release"], ["list", "view"]],
    decision = "allow",
)

prefix_rule(
    pattern = ["gh", "label", "list"],
    decision = "allow",
)

prefix_rule(
    pattern = ["gh", "pr", ["diff", "list", "view"]],
    decision = "allow",
)

prefix_rule(
    pattern = ["gh", "repo", "view"],
    decision = "allow",
)

prefix_rule(
    pattern = ["gh", "search"],
    decision = "allow",
)

prefix_rule(
    pattern = ["gh", "run", ["list", "view", "watch"]],
    decision = "allow",
)

prefix_rule(
    pattern = ["gh", "gist", "view"],
    decision = "allow",
)

prefix_rule(
    pattern = ["npm", "run", ["test", "test:node", "test:ui", "test:live"]],
    decision = "allow",
)

prefix_rule(
    pattern = ["gh", "api"],
    decision = "prompt",
)

prefix_rule(
    pattern = [["kill", "pkill"]],
    decision = "prompt",
)

prefix_rule(
    pattern = ["git", ["clean", "commit", "merge", "push", "rebase", "reset", "restore", "tag"]],
    decision = "prompt",
)

prefix_rule(
    pattern = ["git", "stash", ["apply", "branch", "clear", "drop", "pop", "push", "save", "store"]],
    decision = "prompt",
)

prefix_rule(
    pattern = ["git", "branch", ["-D", "-d"]],
    decision = "prompt",
)

prefix_rule(
    pattern = ["git", "checkout", "--"],
    decision = "prompt",
)

prefix_rule(
    pattern = ["git", "worktree", ["prune", "remove"]],
    decision = "prompt",
)

prefix_rule(
    pattern = ["rm"],
    decision = "prompt",
)
